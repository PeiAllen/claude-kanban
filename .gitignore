.DS_Store
.scratch/
!.claude/
.claude/*
!.claude/commands/
# Obsidian vault config — "Open notes" registers the worktree root as a vault, which creates
# .obsidian/ here. Both patterns match the vault script's own .gitignore write, so it no-ops
# instead of dirtying this tracked file at runtime. (.trash/ = Obsidian's optional in-vault
# trash, only under the non-default "local trash" setting.)
.obsidian/
.trash/

# Planning scratch — the whole top-level notes/ vault (plans + designs) is gitignored local
# scratch, never tracked. The durable rationale lives in docs/ (the SSOT) + commit bodies
# instead; see CLAUDE.md and docs/11-doc-automation.md. The "Open notes" / NotesService product
# features read these files off disk at runtime, so they keep working regardless of git-tracking.
# Root-anchored (`/notes/`, not a bare `notes/`) so it ignores ONLY this repo's top-level vault —
# never a deeper notes/ dir, nor the ContractTests synthetic-repo `notes/*.md` fixtures.
/notes/

# Swift / SwiftPM
.build/
.swiftpm/
# Cross-compiled Linux daemon output (scripts/build-linux-daemon.sh)
dist/
*.xcodeproj
DerivedData/
Package.resolved

# Orchestra runtime artifacts (live under ~/Library/Application Support/Orchestra)
*.sock

# Secrets & signing material — never commit (belt-and-suspenders for a public repo).
# The app keeps its real credentials in the Keychain at runtime; these patterns just make sure
# an APNs key, provisioning profile, or a signing xcconfig can't be added by accident.
.env
.env.*
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.cer
*.certSigningRequest
*.local.xcconfig
*-signing.xcconfig

# Local-only DEBUG demo/screenshot overrides (real paths kept out of the repo; see
# App/DemoConfig.swift + App/DemoConfig.local.json.example).
App/DemoConfig.local.json
.obsidian/
.trash/

# iOS device signing — your Apple team id stays out of git (see scripts/build-ios-device.sh)
App-iOS/DeviceSigning.local.xcconfig
*.local.xcconfig
